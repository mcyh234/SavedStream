# Create your own Telegram application at https://my.telegram.org/apps.
# Do not copy credentials from Telegram Desktop or another third-party client.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# Use a long, random value. This protects the administrator settings and QR login.
ADMIN_KEY=

# Host port published by Docker Compose.
PORT=8000

# Set to true only when the site is served over HTTPS.
COOKIE_SECURE=false

# Browser login lifetime. Telegram's own session is stored separately under /data.
SESSION_COOKIE_DAYS=30

# Internal TeleBox bridge. Generate both values with a password manager or openssl.
TELEBOX_API_TOKEN=
TELEBOX_SECRET_KEY=
TELEBOX_DEFAULT_ACCOUNT=default

# Deployment image tags. deploy.ps1 updates these automatically.
SAVEDSTREAM_IMAGE=savedstream:local
TELEBOX_IMAGE=telebox-bridge:local

# Domain name for automatic HTTPS. Use http://SERVER_IP when deploying without a domain.
CADDY_SITE=http://127.0.0.1
