# syntax=docker/dockerfile:1
FROM node:24-bookworm-slim
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends python3 make g++ git ca-certificates && rm -rf /var/lib/apt/lists/*
COPY package*.json ./
RUN npm ci --no-audit --no-fund
COPY src/ ./src/
COPY scripts/ ./scripts/
COPY bridge-entrypoint.sh ./
RUN useradd --system --uid 10001 --create-home telebox && mkdir -p /data && chmod +x /app/bridge-entrypoint.sh && chown -R telebox:telebox /app /data
USER telebox
ENV TELEBOX_DATA_DIR=/data TELEBOX_PORT=9000 NODE_ENV=production
EXPOSE 9000
VOLUME ["/data"]
ENV TB_LOCALSTORAGE_FILE=/tmp/node-localstorage XDG_CACHE_HOME=/tmp/.cache
HEALTHCHECK --interval=30s --timeout=5s --start-period=45s --retries=5 CMD node -e "fetch('http://127.0.0.1:9000/healthz').then(r=>{if(!r.ok)process.exit(1)}).catch(()=>process.exit(1))"
CMD ["./bridge-entrypoint.sh"]
